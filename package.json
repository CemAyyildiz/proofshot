{
  "name": "proofshot",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter web dev",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:chain": "pnpm --filter @proofshot/contracts dev:chain",
    "seed": "pnpm --filter web db:seed",
    "e2e": "pnpm --filter web e2e",
    "screens": "SCREENS=1 pnpm --filter web e2e screens"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
