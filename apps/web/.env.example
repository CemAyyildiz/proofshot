# ─── Network ────────────────────────────────────────────────────────────────────
# local (Anvil via `pnpm dev:chain`) | testnet (Monad 10143) | mainnet (Monad 143)
PROOFSHOT_NETWORK=testnet
# Defaults come from packages/shared/src/networks.ts. The secondary RPC is used automatically when the primary fails.
RPC_URL=
RPC_URL_SECONDARY=

# ─── Registry (from contracts/deployments/<chainId>.json after a deploy) ────────
REGISTRY_ADDRESS=
REGISTRY_DEPLOY_BLOCK=0
# Max blocks per eth_getLogs call; match your RPC provider's limit. The indexer halves it automatically on refusal.
LOGS_BLOCK_RANGE=1000
# Hot key that sponsors all fees (holds MON). Must not be the Registry admin.
RELAYER_PRIVATE_KEY=
# /api/health turns 503 below this balance so uptime monitoring alerts before Seals fail.
RELAYER_MIN_BALANCE_MON=1
# A Seal request stops waiting for its transaction after this long (a retry reconciles if it landed).
RELAYER_RECEIPT_TIMEOUT_MS=30000

# ─── App ────────────────────────────────────────────────────────────────────────
# Public origin used in emailed links and QR codes.
APP_URL=http://localhost:3000
# Postgres URL in production. Unset in development: an embedded PGlite at .data/pglite is used.
DATABASE_URL=
# Evidence images: "fs" (persistent disk) or "s3" (S3-compatible, e.g. Cloudflare R2). Serverless hosts need "s3".
STORAGE_DRIVER=fs
# fs: absolute directory. Defaults to .data/storage.
STORAGE_DIR=
# s3: a PRIVATE bucket (never public). Endpoint only for non-AWS stores, e.g. https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email (sign-in links) ──────────────────────────────────────────────────────
# Unset: links are printed to the server log and appended to .data/outbox.jsonl.
RESEND_API_KEY=
MAIL_FROM=Proofshot <login@proofshot.app>
SIGNIN_LIMIT_PER_EMAIL=5
# "1" temporarily exposes /spike/passkey in production (real-device passkey fixtures). Leave 0 otherwise.
ENABLE_SPIKE_PAGES=0
# "1" adds "Explore the demo Console" to sign-in: one tap into a seeded demo carrier (for judges). Real carriers are never reachable this way.
DEMO_ACCESS=0
# Tests only: "1" lets a production build print sign-in links instead of emailing them.
MAIL_DEV_OUTBOX=0

# ─── Maintenance ────────────────────────────────────────────────────────────────
# Secret for the daily /api/cron/maintenance call (Vercel Cron sends it as a Bearer token). Unset: disabled.
CRON_SECRET=
