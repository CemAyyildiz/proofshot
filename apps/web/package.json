{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "copy-wasm": "node -e \"require('fs').copyFileSync(require.resolve('@proofshot/fingerprint/pdq.wasm'),'public/pdq.wasm')\"",
    "predev": "pnpm copy-wasm",
    "prebuild": "pnpm copy-wasm",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.mts migrate",
    "db:seed": "tsx scripts/db.mts seed",
    "e2e": "playwright test",
    "pretest": "pnpm copy-wasm"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@proofshot/fingerprint": "workspace:*",
    "@proofshot/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
