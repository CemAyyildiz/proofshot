{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter web build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter web db:migrate"],
    "startCommand": "pnpm --filter web start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
